{
  "name": "antrian-inbound-cbt",
  "private": true,
  "version": "1.0.0",
  "description": "Inbound CBT queue application",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@supabase/realtime-js": "^2.111.0",
    "@vercel/functions": "^3.7.6",
    "pg": "^8.16.3"
  },
  "scripts": {
    "build:realtime": "esbuild js/realtime_client_source.js --bundle --minify --platform=browser --format=iife --outfile=js/realtime_client.js",
    "check": "node --check api/inbound.js && node --check api/sync-superset.js",
    "test": "node --test test/*.test.js",
    "android:sync": "npx cap sync android",
    "android:build:debug": "cd android && gradlew.bat assembleDebug"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "esbuild": "^0.28.1"
  }
}
